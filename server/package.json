{
    "name": "@court/server",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --clear-screen=false src/index.ts",
        "dev:mock": "tsx watch --clear-screen=false src/index.ts --mock",
        "start": "tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:live": "vitest run test/live.test.ts"
    },
    "dependencies": {
        "@court/shared": "2.0.0",
        "@google/genai": "^2.28.0",
        "@langchain/core": "^1.2.17",
        "@langchain/langgraph": "^1.4.21",
        "@langchain/langgraph-checkpoint": "^1.1.4",
        "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
        "better-sqlite3": "^12.10.0",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "socket.io": "^4.8.1",
        "winston": "^3.18.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.4",
        "@types/node": "^24.9.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3"
    }
}
